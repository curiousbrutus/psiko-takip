{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "dev:api": "npm run start:dev --workspace @psikotakip/api",
    "build:api": "npm run build --workspace @psikotakip/api",
    "typecheck:api": "npm run typecheck --workspace @psikotakip/api",
    "smoke:api": "node scripts/smoke-api-e2e.js",
    "seed:demo": "node scripts/demo/seed-therapist-showcase.js",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "typecheck:shared": "tsc -p packages/shared/tsconfig.json --noEmit"
  },
  "dependencies": {
